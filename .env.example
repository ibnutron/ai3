# Optional. If set, model calls use your own Anthropic key instead of
# the aiolah plan you signed in with via `aiolah auth login`.
ANTHROPIC_API_KEY=
# Direct mode only (`aiolah serve --port`): shared secret for "aiolah attach"
# and /code "direct" devices. Not needed for `aiolah rc` / relay mode.
AIOLAH_REMOTE_TOKEN=
# Operators only (`aiolah relay`): must match CLI_RELAY_SECRET in the Laravel app.
CLI_RELAY_SECRET=
